# Charset no header Content-Type (o <meta charset> sozinho não basta para clientes HTTP simples)
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .txt .xml

# Security headers
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Content-Security-Policy "frame-ancestors 'self'"
</IfModule>

# Redirect www -> non-www
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.smartpetgadgets\.com\.br$ [NC]
RewriteRule ^(.*)$ https://smartpetgadgets.com.br/$1 [L,R=301]

# Backups internos removidos: 410 Gone para o Google desindexar
RewriteRule ^reports/ - [G,L]
RewriteRule ^_backup - [G,L]
RewriteRule ^cluster-comedouro-automatico-pet/ - [G,L]

# Arquivos de trabalho (briefs, planos, relatórios) nunca são públicos
<FilesMatch "\.(md|json)$">
    Require all denied
</FilesMatch>

# BEGIN SLUG REDIRECTS
Redirect 301 /soprador-para-pet/ https://smartpetgadgets.com.br/soprador-pet/
Redirect 301 /melhor-camera-para-monitorar-pet/ https://smartpetgadgets.com.br/camera-para-monitorar-pet/
Redirect 301 /duvidas-camera-para-monitorar-pet/ https://smartpetgadgets.com.br/camera-para-monitorar-pet/
# END SLUG REDIRECTS
