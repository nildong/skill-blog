# Copie este arquivo para .env (mesma pasta) e preencha com seus dados reais.
# O arquivo .env é ignorado pelo git e nunca deve ser commitado.

# Host do servidor Hostinger (ex: srv807.hstgr.io) — veja em
# hPanel > Websites > smartpetgadgets.com.br > Arquivos > Contas FTP
SFTP_HOST=

# Usuário SFTP
SFTP_USER=

# Porta SFTP (Hostinger geralmente usa 65002 para SFTP, 22 para SSH pleno)
SFTP_PORT=65002

# Caminho da chave privada SSH (RECOMENDADO — evita usar senha em texto)
SFTP_KEY_PATH=~/.ssh/hostinger_id_ed25519

# Senha (fallback — só use se não tiver chave SSH configurada; requer sshpass)
# SFTP_PASSWORD=

# Diretório remoto base onde o site fica hospedado
REMOTE_BASE=public_html

# Domínio do site (usado para gerar sitemap.xml e mostrar a URL publicada)
SITE_DOMAIN=https://smartpetgadgets.com.br
